{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yeon-sik/notion-project-docs/blob/main/skills/maintain-project-docs/assets/project-docs.config.schema.json",
  "title": "Notion Project Docs configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "canonicalBranch", "documents"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "canonicalBranch": {
      "type": "string",
      "minLength": 1
    },
    "publicationMode": {
      "type": "string",
      "enum": ["manual", "on-main-push"],
      "default": "manual"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "path"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\].*\\.md$"
          },
          "requiredSections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
