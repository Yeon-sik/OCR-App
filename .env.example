# Safe build defaults. Do not put Gemini API keys or account passwords here.
NUTRITION_SUPABASE_URL=https://your-project.supabase.co
NUTRITION_SUPABASE_ANON_KEY=your-publishable-or-anon-key
GEMINI_MODEL=gemini-3.5-flash-lite

# GEMINI_API_KEY, EMAIL, and PASSWORD are intentionally not consumed by Gradle.
