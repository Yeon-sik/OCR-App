# Android 개인용/내부용 빌드 설정. 저장소 루트의 .env로 복사하세요.
# 필수 항목을 실제 값으로 채운 뒤 빌드하세요. 빈 필수 값은 빌드를 차단합니다.
# 이 파일의 값은 BuildConfig/APK에 포함됩니다.
# Windows 앱 설정은 desktop-app/.env.example을 사용하세요.

# 필수: Fitness Nutrition 연결 및 로그인
# NUTRITION_SUPABASE_ANON_KEY에는 publishable 또는 anon 클라이언트 키를 입력하세요.
# Android의 EMAIL/PASSWORD는 Windows의 NUTRITION_EMAIL/NUTRITION_PASSWORD에 해당합니다.
NUTRITION_SUPABASE_URL=
NUTRITION_SUPABASE_ANON_KEY=
EMAIL=
PASSWORD=

# 필수: Gemini 교정 제안
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 선택: PriceTrace 연결. 사용할 때 URL과 키를 함께 채우세요.
PRICETRACE_SUPABASE_URL=
PRICETRACE_SUPABASE_PUBLISHABLE_KEY=

# 선택: CashOS 연결. 사용할 때 URL과 키를 함께 채우세요.
CASHOS_SUPABASE_URL=
CASHOS_SUPABASE_PUBLISHABLE_KEY=

# 선택: Evidence 원본 보관 연결. 사용할 때 URL과 키를 함께 채우세요.
# Evidence 로그인은 Android 앱에서 설정합니다.
EVIDENCE_SUPABASE_URL=
EVIDENCE_SUPABASE_PUBLISHABLE_KEY=
