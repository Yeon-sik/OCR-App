# Windows 앱 런타임 설정. 값은 EXE 빌드에 포함되지 않습니다.
# 이 파일을 %LOCALAPPDATA%\YeonsikIngestionConsole\.env로 복사하세요.
# 다른 경로를 쓰려면 YEONSIK_INGESTION_ENV_FILE에 .env의 전체 경로를 지정하세요.
# Windows 앱은 저장소 루트의 .env를 자동으로 읽지 않습니다.
# 사용하지 않는 서비스의 항목은 비워 두세요.
# 사용하는 서비스에는 URL, publishable/anon 클라이언트 키와 로그인 정보가 필요합니다.
# service_role 또는 sb_secret_ 키는 입력하지 마세요.
# 로그인 방식 1: 해당 서비스의 EMAIL과 PASSWORD를 채우세요.
# 로그인 방식 2: 같은 세션의 USER_ID, ACCESS_TOKEN, REFRESH_TOKEN을 모두 채우세요.
# 이메일/비밀번호 방식을 사용하면 세션 3종은 비워 두세요.

# Evidence: .yeonsik 번들의 원본 보관에 필요합니다.
EVIDENCE_SUPABASE_URL=
EVIDENCE_SUPABASE_PUBLISHABLE_KEY=
EVIDENCE_EMAIL=
EVIDENCE_PASSWORD=
# 선택: 이메일/비밀번호 대신 기존 세션으로 시작할 때만 사용합니다.
# Evidence는 EMAIL/PASSWORD가 모두 있으면 아래 세션 3종을 무시합니다.
EVIDENCE_USER_ID=
EVIDENCE_ACCESS_TOKEN=
EVIDENCE_REFRESH_TOKEN=

# PriceTrace: 구매 및 가격 정보 전송에 필요합니다.
PRICETRACE_SUPABASE_URL=
PRICETRACE_SUPABASE_PUBLISHABLE_KEY=
PRICETRACE_EMAIL=
PRICETRACE_PASSWORD=
# 선택: 기존 세션
PRICETRACE_USER_ID=
PRICETRACE_ACCESS_TOKEN=
PRICETRACE_REFRESH_TOKEN=

# Fitness Nutrition: 영양 정보 및 식사 전송에 필요합니다.
NUTRITION_SUPABASE_URL=
NUTRITION_SUPABASE_PUBLISHABLE_KEY=
# 호환 키 이름: 위 PUBLISHABLE_KEY와 아래 ANON_KEY 중 하나만 채우세요.
NUTRITION_SUPABASE_ANON_KEY=
NUTRITION_EMAIL=
NUTRITION_PASSWORD=
# 선택: 기존 세션
NUTRITION_USER_ID=
NUTRITION_ACCESS_TOKEN=
NUTRITION_REFRESH_TOKEN=

# CashOS: 지출 정보 전송에 필요합니다.
CASHOS_SUPABASE_URL=
CASHOS_SUPABASE_PUBLISHABLE_KEY=
CASHOS_EMAIL=
CASHOS_PASSWORD=
# 선택: 기존 세션
CASHOS_USER_ID=
CASHOS_ACCESS_TOKEN=
CASHOS_REFRESH_TOKEN=
